# Template for Kubernetes secrets
# DO NOT commit this file with actual values!
# Create the actual secret using: kubectl create secret generic bantam-secrets --from-literal=...
# Or use sealed-secrets, external-secrets, or your cluster's secret management solution

apiVersion: v1
kind: Secret
metadata:
  name: bantam-secrets
type: Opaque
stringData:
  supabase-url: "YOUR_SUPABASE_URL"
  supabase-anon-key: "YOUR_SUPABASE_ANON_KEY"
  supabase-service-role-key: "YOUR_SUPABASE_SERVICE_ROLE_KEY"
  jwt-secret: "YOUR_JWT_SECRET"
