# Cluster/Production Environment Variables
# Use service names for internal cluster communication
VITE_API_BASE_URL=http://backend:8080/api
VITE_SOCKET_URL=http://backend:8080
VITE_AI_SERVICE_URL=http://ai-service:8083

# For external access, use your actual domain:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
# VITE_AI_SERVICE_URL=https://ai.yourdomain.com

VITE_MAPBOX_TOKEN=your_mapbox_token_here
