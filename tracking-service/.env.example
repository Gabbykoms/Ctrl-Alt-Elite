# Docker Compose Environment Variables for Tracking Service
# Copy this to .env.local for development or customize values as needed

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tracking_db
DB_USER=tracking_user
DB_PASSWORD=tracking_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Application Configuration
PORT=8081
SPRING_PROFILES_ACTIVE=docker

# NOTE: For Kubernetes deployment, update these values to use service DNS names:
# DB_HOST=postgres.default.svc.cluster.local (or appropriate namespace)
# REDIS_HOST=redis.default.svc.cluster.local
# Or create ConfigMaps and Secrets in K8s manifests with appropriate values
