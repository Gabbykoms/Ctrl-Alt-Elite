# Trinity AI Service - Local Development Environment Variables
# Copy this file to .env and fill in your actual values

# Service Configuration
AI_SERVICE_NAME=bantam-ai-service
AI_SERVICE_PORT=8083
AI_ENVIRONMENT=development
AI_LOG_LEVEL=INFO

# Database (Supabase)
AI_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
AI_SUPABASE_URL=https://[PROJECT-REF].supabase.co
AI_SUPABASE_KEY=your-supabase-anon-key

# OpenAI API
AI_OPENAI_API_KEY=sk-your-openai-api-key

# LangChain Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Generation Parameters
MAX_TOKENS=500
TEMPERATURE=0.7

# RAG Settings
SIMILARITY_THRESHOLD=0.5
MAX_CONTEXT_DOCUMENTS=5
VECTOR_DIMENSION=1536

# Weather API (Optional)
OPENWEATHER_API_KEY=your-openweather-api-key

# External Services
TRACKING_SERVICE_URL=http://localhost:8081/api/tracking

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_CHAT_REQUESTS_QUEUE=chat.requests
RABBITMQ_CHAT_RESPONSES_QUEUE=chat.responses

# CORS
AI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Knowledge Base Ingestion
INGEST_KB=false
