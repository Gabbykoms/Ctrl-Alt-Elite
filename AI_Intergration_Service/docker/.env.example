# ==============================================================================
# Environment Variables for Trinity Shuttle AI Service
# ==============================================================================
# Copy this file to .env and fill in the required values
# ==============================================================================

# SERVICE CONFIGURATION
# ==============================================================================
SERVICE_NAME=trinity-ai-service
SERVICE_PORT=8083
ENVIRONMENT=development
LOG_LEVEL=INFO

# DATABASE CONFIGURATION - SUPABASE
# ==============================================================================
# Get your Supabase DATABASE_URL from: https://supabase.com/dashboard
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Supabase credentials (optional, for additional services)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# OPENAI CONFIGURATION
# ==============================================================================
# Required: Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_test_your_key_here

# LANGCHAIN/LANGRAPH CONFIGURATION
# ==============================================================================
# Models to use for embeddings and chat
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Generation parameters
MAX_TOKENS=500
TEMPERATURE=0.7

# RAG (Retrieval Augmented Generation) SETTINGS
# ==============================================================================
# Lower threshold = more permissive retrieval (0.0-1.0)
SIMILARITY_THRESHOLD=0.5

# Number of documents to retrieve for context
MAX_CONTEXT_DOCUMENTS=5

# Vector dimension for embeddings (text-embedding-3-small uses 1536)
VECTOR_DIMENSION=1536

# EXTERNAL SERVICES
# ==============================================================================
# Tracking service URL (for shuttle real-time tracking integration)
TRACKING_SERVICE_URL=http://localhost:8082/api/tracking

# CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# OPTIONAL SERVICES
# ==============================================================================
# OpenWeather API (optional, for weather-aware shuttle scheduling)
OPENWEATHER_API_KEY=

# Supabase (optional, if using Supabase for additional services)
SUPABASE_URL=
SUPABASE_KEY=

# ==============================================================================
# DOCKER COMPOSE SPECIFIC VARIABLES
# ==============================================================================
# Only used when running with docker-compose
DOCKER_REGISTRY=
DOCKER_TAG=latest
